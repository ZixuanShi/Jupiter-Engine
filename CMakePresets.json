{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/_ProjectFiles/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++",
                "JUPITER_PRESET": "${presetName}"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_OBJCXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
            }
        },
        {
            "name": "ios-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_OBJCXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0"
            }
        },
        {
            "name": "ios-device-base",
            "hidden": true,
            "inherits": "ios-base",
            "cacheVariables": {
                "CMAKE_OSX_SYSROOT": "iphoneos"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows_debug",
            "displayName": "Windows Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows_dev",
            "displayName": "Windows Dev",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
            }
        },
        {
            "name": "windows_release",
            "displayName": "Windows Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos_debug",
            "displayName": "macOS Debug",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos_dev",
            "displayName": "macOS Dev",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
            }
        },
        {
            "name": "macos_release",
            "displayName": "macOS Release",
            "inherits": "macos-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ios-device_debug",
            "displayName": "iOS Device Debug",
            "inherits": "ios-device-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ios-device_dev",
            "displayName": "iOS Device Dev",
            "inherits": "ios-device-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
            }
        },
        {
            "name": "ios-device_release",
            "displayName": "iOS Device Release",
            "inherits": "ios-device-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux_debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux_dev",
            "displayName": "Linux Dev",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
            }
        },
        {
            "name": "linux_release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows_debug",
            "configurePreset": "windows_debug"
        },
        {
            "name": "windows_dev",
            "configurePreset": "windows_dev"
        },
        {
            "name": "windows_release",
            "configurePreset": "windows_release"
        },
        {
            "name": "macos_debug",
            "configurePreset": "macos_debug"
        },
        {
            "name": "macos_dev",
            "configurePreset": "macos_dev"
        },
        {
            "name": "macos_release",
            "configurePreset": "macos_release"
        },
        {
            "name": "ios-device_debug",
            "configurePreset": "ios-device_debug"
        },
        {
            "name": "ios-device_dev",
            "configurePreset": "ios-device_dev"
        },
        {
            "name": "ios-device_release",
            "configurePreset": "ios-device_release"
        },
        {
            "name": "linux_debug",
            "configurePreset": "linux_debug"
        },
        {
            "name": "linux_dev",
            "configurePreset": "linux_dev"
        },
        {
            "name": "linux_release",
            "configurePreset": "linux_release"
        }
    ]
}
