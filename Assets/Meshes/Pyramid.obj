# Jupiter Engine -- unit pyramid, square base, faceted normals.
# Faces are wound counter-clockwise seen from outside, the OBJ convention.

# The three floats after each position are the `v x y z r g b` vertex-colour extension.
# Linear, not sRGB: nothing between here and the framebuffer decodes, and the layer's _sRGB
# format applies the transfer function on write, so byte-style values here would double-encode.
v -0.5 -0.5  0.5   0.90 0.15 0.15
v  0.5 -0.5  0.5   0.15 0.75 0.25
v  0.5 -0.5 -0.5   0.15 0.35 0.95
v -0.5 -0.5 -0.5   0.95 0.75 0.15
v  0.0  0.5  0.0   1.00 1.00 1.00

# Every side face is the same triangle in UV space -- two base corners and the apex. The base
# quad takes the unit square, so it reads as a visibly different island from the sides.
vt 0.0 0.0
vt 1.0 0.0
vt 0.5 1.0
vt 0.0 1.0
vt 1.0 1.0

vn  0.0000000  0.4472136  0.8944272
vn  0.8944272  0.4472136  0.0000000
vn  0.0000000  0.4472136 -0.8944272
vn -0.8944272  0.4472136  0.0000000
vn  0.0000000 -1.0000000  0.0000000

f 1/1/1 2/2/1 5/3/1
f 2/1/2 3/2/2 5/3/2
f 3/1/3 4/2/3 5/3/3
f 4/1/4 1/2/4 5/3/4

# A quad, so the loader's fan triangulation gets exercised.
f 1/1/5 4/4/5 3/5/5 2/2/5
