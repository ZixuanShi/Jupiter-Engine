{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup",
            "type": "shell",
            "command": "python3 Scripts/setup.py",
            "windows": { "command": "py Scripts/setup.py" },
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "python3 Scripts/build.py",
            "windows": { "command": "py Scripts/build.py" },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "python3 Scripts/run.py",
            "windows": { "command": "py Scripts/run.py" },
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "python3 Scripts/clean.py",
            "windows": { "command": "py Scripts/clean.py" },
            "problemMatcher": []
        }
    ]
}
